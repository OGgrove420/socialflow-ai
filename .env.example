# SocialFlow AI — environment template (never put real values here)
# core (already set on vercel)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service role: used ONLY by /api/cron/publish for job claims (bypasses rls)
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte base64 key: AES-256-GCM encryption for stored platform tokens
SF_ENCRYPTION_KEY=
# bearer secret the vercel cron sends to /api/cron/publish
CRON_SECRET=
# canonical public origin (used to build oauth redirect uris)
NEXT_PUBLIC_SITE_URL=

# ---- platform developer credentials (app owner registers; users never see these) ----
# meta app covers facebook pages + instagram professional (same client id/secret)
SF_FACEBOOK_CLIENT_ID=
SF_FACEBOOK_CLIENT_SECRET=
# linkedin (one app, both profile + company page adapters)
SF_LINKEDIN_CLIENT_ID=
SF_LINKEDIN_CLIENT_SECRET=
# tiktok content posting api
SF_TIKTOK_CLIENT_ID=
SF_TIKTOK_CLIENT_SECRET=
# x (twitter) oauth2 — the existing X_API_KEY/X_API_SECRET/X_ACCESS_TOKEN* legacy
# single-account vars keep working for /api/x/* and are unrelated to this flow
SF_X_CLIENT_ID=
SF_X_CLIENT_SECRET=
# youtube (google cloud project)
SF_YOUTUBE_CLIENT_ID=
SF_YOUTUBE_CLIENT_SECRET=
# pinterest v5
SF_PINTEREST_CLIENT_ID=
SF_PINTEREST_CLIENT_SECRET=

# ---- redirect uris to register in each developer portal ----
# meta:  https://<your-domain>/api/oauth/facebook/callback  +  /api/oauth/instagram/callback
# linkedin: https://<your-domain>/api/oauth/linkedin/callback  +  /api/oauth/linkedin_page/callback
# tiktok: https://<your-domain>/api/oauth/tiktok/callback
# x: https://<your-domain>/api/oauth/x/callback
# google: https://<your-domain>/api/oauth/youtube/callback
# pinterest: https://<your-domain>/api/oauth/pinterest/callback
